# Taurus Go environment secrets example.
# Copy this file to .env, fill real values, then run: .\setup-env.ps1
# .env is gitignored. Never commit real secrets.

# JWT signing secret shared by all services while HS256 is used.
# Generate with: openssl rand -base64 48
# Rotating this logs all users out once.
JWT_SECRET=

# Postgres password used by host-run services such as employee, project, and gamification.
# Before production, rotate the old dev values in Postgres itself, then put the new value here.
DB_PASSWORD=

# Spring Cloud Config encryption key.
# Generate a new value, then re-encrypt every {cipher} value in config-server/src/main/resources/config-repo.
ENCRYPT_KEY=

# M7: Basic-auth credentials protecting the Eureka registry/dashboard (:8761).
# The registry lists every service's host/IP/port, so it must not be public.
# EUREKA_PASSWORD must be URL-safe (letters+digits) -- it is embedded in the
# eureka defaultZone URL http://user:pass@localhost:8761/eureka/.
EUREKA_USER=eureka
EUREKA_PASSWORD=

# This is only for local/dev Compose; production identity config should be managed separately.

# Optional production owner allow-list for the platform console.
# PLATFORM_OWNER_EMAILS=owner@example.com
