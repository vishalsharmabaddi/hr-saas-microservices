# ─────────────────────────────────────────────────────────────
# Taurus Go — environment secrets (example)
# Copy real values into your shell before running services in PROD.
# Local dev works WITHOUT these (each application.yml has a dev default),
# but PRODUCTION MUST set strong values here — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# JWT signing secret — shared by all services (HS256). Use >= 32 random bytes.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Postgres password (employee / gamification / project services)
DB_PASSWORD=

# ─── How to set (Windows PowerShell), then run the service ───
#   $env:JWT_SECRET = "your-strong-secret"
#   $env:DB_PASSWORD = "your-db-password"
#   mvn spring-boot:run
#
# ─── Linux/Mac ───
#   export JWT_SECRET="your-strong-secret"
#   export DB_PASSWORD="your-db-password"
#
# NOTE: all services must share the SAME JWT_SECRET (tokens are cross-service).
